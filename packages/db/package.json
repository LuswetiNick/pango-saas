{
  "name": "@workspace/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm db:generate && tsc --noEmit",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "format": "prettier --write \"*.{ts,json}\" \"src/**/*.ts\" && prisma format",
    "lint": "eslint .",
    "typecheck": "pnpm db:generate && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "typescript": "^5"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  }
}
